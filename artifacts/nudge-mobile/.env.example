# Client-safe Firebase Web SDK values for local development.
# Copy this file to .env.local and fill it with the values from the Firebase
# project settings page. These identifiers are safe to ship to a client when
# protected by Firebase Security Rules; they are not server credentials.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Used by the shared API client when server-backed features are enabled.
EXPO_PUBLIC_DOMAIN=